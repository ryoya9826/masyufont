% ----------------------------------------------------------------------------
% masyufont.sty
%
% Font presets for documents compiled with both (u)pLaTeX and LuaLaTeX
%
% Author:  Ryoya Ando
% URL:     https://ryoya9826.github.io/
%
% Copyright (C) 2019-2026 Ryoya Ando
%
% This work is released under the MIT License.
% See the file LICENSE for the full license text.
%
% This work consists of the files masyufont.sty, masyufont-doc.tex,
% masyufont-doc.pdf, README.md and LICENSE.
%
% Description:
% This package selects the text font and the math font by the name of a
% preset. One preset holds the settings for LuaLaTeX (luatexja-fontspec)
% and for (u)pLaTeX (pxchfon), so the same source compiles on both.
%
% Usage:
% \usepackage{masyufont}
% \masyufont{IPA}            -> IPA Mincho / IPA Gothic, default math font
% \masyufont[xits]{BIZUD}    -> BIZ UD fonts, XITS Math (LuaLaTeX only)
% When \masyufont is not used, newtxtext and newtxmath are loaded.
% ----------------------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{masyufont}[2026/11/26 v0.2 Font presets for pLaTeX and LuaLaTeX]
\RequirePackage{iftex}
\RequirePackage{xkeyval}
\RequirePackage{etoolbox}

% 対応するのは LuaTeX と pTeX 系（pTeX，upTeX）だけである
\ifluatex\else\ifptex\else
  \PackageError{masyufont}{%
    This package works only with LuaLaTeX, pLaTeX or upLaTeX}{%
    Compile the document with lualatex, platex or uplatex.}%
  \endinput\fi\fi % \endinput は行末で効くので，同じ行で条件を閉じる

% ---- パッケージオプション -------------------------------------------------
\newif\ifmasyu@alphabet
\DeclareOption{alphabet}{\masyu@alphabettrue}
\ProcessOptions\relax

\ifptex
  \ifmasyu@alphabet
    \RequirePackage[alphabet]{pxchfon}
  \else
    \RequirePackage[noalphabet]{pxchfon}
  \fi
\else
  \ifmasyu@alphabet
    \PackageWarningNoLine{masyufont}{%
      Option `alphabet' is available only with (u)pLaTeX}%
  \fi
\fi

% ---- 情報の出力 -----------------------------------------------------------
\def\masyu@fontselected#1{%
  \PackageInfo{masyufont}{Font `#1' is selected}}
\def\masyu@packageloaded#1{%
  \PackageInfo{masyufont}{Package `#1' is loaded}}

% ---- プリセットの登録 -----------------------------------------------------
% #1: プリセット名，#2: LuaLaTeX での設定，#3: (u)pLaTeX での設定
\def\masyu@define#1#2#3#4{%
  \define@key[masyu]{#1}{#2}[]{%
    \ifluatex #3\else #4\fi
  }%
}

% \masyuMainFontDefine{名前}{LuaLaTeX での設定}{(u)pLaTeX での設定}
\newcommand\masyuMainFontDefine[3]{\masyu@define{mainfont}{#1}{#2}{#3}}
% \masyuMathFontDefine{名前}{LuaLaTeX での設定}{(u)pLaTeX での設定}
\newcommand\masyuMathFontDefine[3]{\masyu@define{mathfont}{#1}{#2}{#3}}
\@onlypreamble\masyuMainFontDefine
\@onlypreamble\masyuMathFontDefine

% ---- プリセットの呼び出し -------------------------------------------------
\newif\ifmasyu@fontset

% \masyufont[数式フォント]{本文フォント}
\newcommand\masyufont[2][default]{%
  \ifmasyu@fontset
    \PackageWarning{masyufont}{%
      \string\masyufont\space is used more than once}%
  \fi
  \global\masyu@fontsettrue
  \setkeys[masyu]{mathfont}{#1}%
  \setkeys[masyu]{mainfont}{#2}%
}
\@onlypreamble\masyufont

% \masyufont を使わなかったときは既定のプリセットを読み込む
\AtEndPreamble{%
  \ifmasyu@fontset\else
    \masyufont[default]{default}%
  \fi
}

% ---- 本文フォントのプリセット ---------------------------------------------
\masyuMainFontDefine{default}{%
  \RequirePackage{newtxtext}%
  \masyu@packageloaded{newtxtext}%
}{%
  \RequirePackage{newtxtext}%
  \masyu@packageloaded{newtxtext}%
}

\masyuMainFontDefine{timesnew}{%
  \RequirePackage{newtxtext}%
  \masyu@packageloaded{newtxtext}%
}{%
  \RequirePackage{newtxtext}%
  \masyu@packageloaded{newtxtext}%
}

\masyuMainFontDefine{IPA}{%
  \setmainfont[Ligatures=TeX,BoldFont={ipam.ttf}]{ipam.ttf}%
  \setsansfont[Ligatures=TeX,BoldFont={ipag.ttf}]{ipag.ttf}%
  \setmainjfont[Ligatures=TeX,BoldFont={ipam.ttf}]{ipam.ttf}%
  \setsansjfont[Ligatures=TeX,BoldFont={ipag.ttf}]{ipag.ttf}%
  \masyu@fontselected{ipam.ttf}\masyu@fontselected{ipag.ttf}%
}{%
  \setminchofont{ipam.ttf}%
  \setgothicfont{ipag.ttf}%
  \masyu@fontselected{ipam.ttf}\masyu@fontselected{ipag.ttf}%
}

\masyuMainFontDefine{Kyokasyo}{%
  \setmainfont[Ligatures=TeX,BoldFont={UDDigiKyokashoN-B.ttc}]{UDDigiKyokashoN-R.ttc}%
  \setsansfont[Ligatures=TeX,BoldFont={UDDigiKyokashoN-B.ttc}]{UDDigiKyokashoN-B.ttc}%
  \setmainjfont[Ligatures=TeX,BoldFont={UDDigiKyokashoN-B.ttc}]{UDDigiKyokashoN-R001.ttf}%
  \setsansjfont[Ligatures=TeX,BoldFont={UDDigiKyokashoN-B.ttc}]{UDDigiKyokashoN-B.ttc}%
  \masyu@fontselected{UDDigiKyokashoN-R.ttc}%
  \masyu@fontselected{UDDigiKyokashoN-B.ttc}%
}{%
  \setminchofont[1]{UDDigiKyokashoN-R.ttc}%
  \setgothicfont[1]{UDDigiKyokashoN-B.ttc}%
  \masyu@fontselected{UDDigiKyokashoN-R.ttc}%
  \masyu@fontselected{UDDigiKyokashoN-B.ttc}%
}

\masyuMainFontDefine{BIZUD}{%
  \setmainfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDMinchoM.ttc}%
  \setsansfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDGothicR.ttc}%
  \setmainjfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDMinchoM.ttc}%
  \setsansjfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDGothicR.ttc}%
  \masyu@fontselected{BIZ-UDMinchoM.ttc}\masyu@fontselected{BIZ-UDGothicR.ttc}%
}{%
  \setminchofont{BIZ-UDMincho-Medium-01.ttf}%
  \setgothicfont{BIZ-UDGothicR001.ttf}%
  \masyu@fontselected{BIZ-UDMincho-Medium-01.ttf}%
  \masyu@fontselected{BIZ-UDGothicR001.ttf}%
}

\masyuMainFontDefine{BIZUDo}{%
  \setmainfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDMinchoM.ttc}%
  \setsansfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDGothicR.ttc}%
  \setmainjfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDMinchoM.ttc}%
  \setsansjfont[Ligatures=TeX,BoldFont={BIZ-UDGothicB.ttc}]{BIZ-UDGothicR.ttc}%
  \masyu@fontselected{BIZ-UDMinchoM.ttc}\masyu@fontselected{BIZ-UDGothicR.ttc}%
}{%
  \setminchofont[1]{BIZ-UDMinchoM.ttc}%
  \setgothicfont{BIZ-UDGothicR001.ttf}%
  \masyu@fontselected{BIZ-UDMinchoM.ttc}\masyu@fontselected{BIZ-UDGothicR001.ttf}%
}

\masyuMainFontDefine{oradano}{%
  \setmainfont{OradanoGSRR.ttf}%
  \setsansfont{OradanoGSRR.ttf}%
  \setmainjfont{OradanoGSRR.ttf}%
  \setsansjfont{OradanoGSRR.ttf}%
  \masyu@fontselected{OradanoGSRR.ttf}%
}{%
  \setminchofont{OradanoGSRR.ttf}%
  \setgothicfont{OradanoGSRR.ttf}%
  \masyu@fontselected{OradanoGSRR.ttf}%
}

\masyuMainFontDefine{yumin}{%
  \setmainfont[Ligatures=TeX,BoldFont={yumindb.ttf}]{yumin.ttf}%
  \setmainjfont[Ligatures=TeX,BoldFont={yumindb.ttf}]{yumin.ttf}%
  \masyu@fontselected{yumin.ttf}%
}{%
  \setminchofont{yumin.ttf}%
  \setgothicfont[0]{YuGothM.ttc}%
  \masyu@fontselected{yumin.ttf}\masyu@fontselected{YuGothM.ttc}%
}

\masyuMainFontDefine{mika}{%
  \setmainfont[Ligatures=TeX]{mikachanALL001.ttf}%
  \setsansfont[Ligatures=TeX]{mikachanALL003.ttf}%
  \setmainjfont[Ligatures=TeX]{mikachanALL001.ttf}%
  \setsansjfont[Ligatures=TeX]{mikachanALL003.ttf}%
  \masyu@fontselected{mikachanALL001.ttf}\masyu@fontselected{mikachanALL003.ttf}%
}{%
  \RequirePackage[mainfont]{pxmika}%
  \masyu@packageloaded{pxmika}%
  \def\headfont{\amikafamily}%
  \def\normalfont{\amikafamily}%
  \AtBeginDocument{\renewcommand\rmdefault{amikafamily}\normalfont}%
}

% ---- 数式フォントのプリセット ---------------------------------------------
\masyuMathFontDefine{default}{%
  \RequirePackage{newtxmath}%
  \masyu@packageloaded{newtxmath}%
}{%
  \RequirePackage{newtxmath}%
  \masyu@packageloaded{newtxmath}%
}

\masyuMathFontDefine{timesnew}{%
  \RequirePackage{newtxmath}%
  \masyu@packageloaded{newtxmath}%
}{%
  \RequirePackage{newtxmath}%
  \masyu@packageloaded{newtxmath}%
}

\masyuMathFontDefine{xits}{%
  \RequirePackage{unicode-math}%
  \unimathsetup{math-style=ISO,bold-style=ISO}%
  \setmathfont{XITS-Math}%
  \setmathfont{XITS-Math}[range={cal,bfcal},StylisticSet=1]%
  \masyu@packageloaded{unicode-math}%
}{%
  \PackageWarning{masyufont}{%
    Math font `xits' is available only with LuaLaTeX.\MessageBreak
    newtxmath is used instead}%
  \RequirePackage{newtxmath}%
  \masyu@packageloaded{newtxmath}%
}

\endinput
